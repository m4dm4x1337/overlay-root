#!/bin/sh
#
#  Read-only root filesystem using overlayfs
#
#  Modified 2026 by m4dm4x1337 (fixed legacy overlayfs support, see v4.0.0 changelog)
#
#  Modified 2023 by m4dm4x1337 (fixed 2 bugs, see v3.0.0 changelog)
#
#  Modified 2015 by Pascal Rosin to work on raspian-ua-netinst with
#  overlayfs integrated in Linux Kernel >= 3.18.
#
#  Originally written by Axel Heider (Copyright 2012) for Ubuntu 11.10.
#  This version can be found here:
#  https://help.ubuntu.com/community/aufsRootFileSystemOnUsbFlash#Overlayfs
#
#  Based on scripts from
#    Sebastian P.
#    Nicholas A. Schembri State College PA USA
